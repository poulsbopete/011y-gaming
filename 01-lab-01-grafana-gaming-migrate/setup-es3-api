#!/bin/bash
# Lab 1 host setup: refresh migrate script from GitHub so CLI flag renames + ES schema discovery land mid-play.
set -euxo pipefail

WORKSHOP="${WORKSHOP_ROOT:-/root/workshop}"
URL="${WORKSHOP_GIT_URL:-https://github.com/poulsbopete/011y-gaming.git}"
REF="${WORKSHOP_GIT_REF:-main}"
_ghpath="${URL#*github.com/}"
_ghpath="${_ghpath#*:}"
_ghpath="${_ghpath%.git}"
_owner_repo="$(printf '%s\n' "$_ghpath" | cut -d/ -f1-2)"
[[ "$_owner_repo" != *"/"* ]] && _owner_repo="poulsbopete/011y-gaming"

BASE="https://raw.githubusercontent.com/${_owner_repo}/${REF}"
mkdir -p "${WORKSHOP}/scripts" "${WORKSHOP}/tools" "${WORKSHOP}/workflows" \
  "${WORKSHOP}/assets/elasticsearch/templates" "${WORKSHOP}/assets/grafana"

_refresh() {
  local rel="$1"
  if curl -fsSL "${BASE}/${rel}" -o "${WORKSHOP}/${rel}"; then
    echo "OK: refreshed ${rel} from ${_owner_repo}@${REF}"
  else
    echo "WARN: could not refresh ${rel} from GitHub; using track copy" >&2
  fi
}

_refresh "scripts/migrate_grafana_dashboards_to_serverless.sh"
_refresh "scripts/apply_aether_gaming_index_templates.py"
_refresh "scripts/create_aether_ml_anomaly_job.py"
_refresh "scripts/ensure_ai_recommendation_panels.py"
_refresh "scripts/deploy_workshop_workflows.py"
_refresh "scripts/deploy_dashboard_sprawl.py"
_refresh "tools/otel_gaming_fleet.py"
_refresh "tools/patch_aether_dashboard_region_fields.py"
_refresh "tools/patch_aether_dashboard_esql_fields.py"
_refresh "workflows/metrics-adoption-recommendations.yaml"
_refresh "workflows/aether-dashboard-briefs.yaml"
_refresh "assets/elasticsearch/templates/aether-gaming-component-template.json"
_refresh "assets/elasticsearch/templates/aether-gaming-index-template.json"
_refresh "assets/elasticsearch/templates/aether-gaming-default-pipeline.json"

# Latency panels: PromQL must use avg(gauge), not histogram _sum/_count.
for _g in 01-platform-overview 03-session-gateway 05-auth-login 06-store-checkout \
  09-party-social 11-inventory 13-cdn-edge 14-deps-latency; do
  _refresh "assets/grafana/${_g}.json"
done

chmod +x "${WORKSHOP}/scripts/"*.sh 2>/dev/null || true
chmod +x "${WORKSHOP}/scripts/"*.py 2>/dev/null || true
