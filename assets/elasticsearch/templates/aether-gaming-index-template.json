{
  "index_patterns": ["aether-gaming-metrics-*", "metrics-aether.*", "aether-gaming-logs-*", "logs-aether.*"],
  "data_stream": {},
  "composed_of": ["aether-gaming-mappings"],
  "priority": 500,
  "template": {
    "settings": {
      "index": {
        "mode": "standard"
      }
    },
