# Copy these exports for laptop migrate against any Observability Serverless project.
# Do not commit serverless_creds.env (gitignored).

export ES_URL="https://YOUR_PROJECT.es.REGION.PROVIDER.elastic.cloud"
export KIBANA_URL="https://YOUR_PROJECT.kb.REGION.PROVIDER.elastic.cloud"
export ES_API_KEY="YOUR_API_KEY"
export KIBANA_API_KEY="${ES_API_KEY}"

# Optional managed OTLP (or derived from ES_URL .es.→.ingest.)
# export WORKSHOP_OTLP_ENDPOINT="https://YOUR_PROJECT.ingest.REGION.PROVIDER.elastic.cloud"
# export WORKSHOP_OTLP_AUTH_HEADER="ApiKey ${ES_API_KEY}"

# export MIG_TO_KBN_VENV="$HOME/.local/mig-to-kbn-venv"
# export WORKSHOP_SKIP_OTEL=1
# export WORKSHOP_SKIP_AI_NOTES=1
